{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "看板变更建议操作（ops）",
  "description": "一条龙更新流程中 Agent 分析产出的变更建议格式。每次审查必须对当前 review-packet 的全部 source_id 作出结论；ops 可为空，表示无变更结案。",
  "type": "object",
  "required": ["snapshot_id", "reconciliation", "ops"],
  "properties": {
    "snapshot_id": { "type": "string", "description": "必须等于 workflow/review-packet.json 的 snapshot_id" },
    "reconciliation": {
      "type": "array",
      "description": "review-packet 中每个 source_id 恰好一条结论",
      "items": {
        "type": "object",
        "required": ["source_id", "decision"],
        "properties": {
          "source_id": { "type": "string" },
          "decision": { "type": "string", "enum": ["mapped", "irrelevant", "needs_confirmation"] },
          "task_id": { "type": "string", "description": "mapped 时必填" },
          "evidence": { "type": "string", "description": "可选：简短判断依据" }
        },
        "additionalProperties": false
      }
    },
    "ops": { "type": "array", "items": { "$ref": "#/$defs/op" } }
  },
  "$defs": {
    "op": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "type": "string",
          "enum": ["create", "progress", "status", "update", "schedule", "block", "unblock", "complete", "note", "delete"]
        },
        "id": { "type": "string", "description": "任务 id（除 create 外必填）" },
        "title": { "type": "string", "description": "create: 任务名称（必填）" },
        "description": { "type": "string" },
        "to": { "type": ["integer", "string"], "description": "progress/status: 目标值（progress 0-100；status 仅普通状态，blocked/completed 用 block/complete）" },
        "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "schedule: 新的预计完成日期" },
        "reason": { "type": "string", "description": "block: 阻塞原因（必填，trim 后非空）" },
        "content": { "type": "string", "description": "note/complete/block 等: 内容说明" },
        "note": { "type": "string" },
        "priority": { "type": "string", "enum": ["urgent", "high", "normal", "low"] },
        "current_status": { "type": "string" },
        "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "interrupt": { "type": ["boolean", "string"] },
        "at": { "type": "string", "description": "note 回填历史时间，如 2026-08-14T18:00:00" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
