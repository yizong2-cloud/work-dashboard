{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "看板变更建议操作（ops）",
  "description": "一条龙更新流程中 Agent 分析产出的变更建议格式。每次审查必须对当前 review-packet 的全部 source_id 作出结论；ops 可为空，表示无变更结案。",
  "type": "object",
  "required": ["snapshot_id", "reconciliation", "ops"],
  "properties": {
    "snapshot_id": { "type": "string", "description": "必须等于 workflow/review-packet.json 的 snapshot_id" },
    "reconciliation": {
      "type": "array",
      "description": "review-packet 中每个 source_id 恰好一条结论",
      "items": {
        "type": "object",
        "required": ["source_id", "decision"],
        "properties": {
          "source_id": { "type": "string" },
          "decision": { "type": "string", "enum": ["mapped", "reviewed_no_change", "irrelevant", "needs_confirmation"] },
          "task_id": { "type": "string", "description": "mapped 到单个任务时填写（兼容旧格式）" },
          "task_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true, "description": "同一证据涉及多个任务时填写" },
          "evidence": { "type": "string", "description": "可选：简短判断依据" },
          "reason": { "type": "string", "description": "待确认原因或人工确认依据" },
          "impact": { "type": "string", "description": "待确认答案会影响什么" },
          "recommendation": { "type": "string", "description": "Agent 给用户的建议" }
        },
        "additionalProperties": false
      }
    },
    "ops": { "type": "array", "items": { "$ref": "#/$defs/op" } }
  },
  "$defs": {
    "op": {
      "type": "object",
      "required": ["op"],
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "create" } }, "required": ["op"] },
          "then": { "required": ["title", "creation_basis", "source_ids"] }
        },
        {
          "if": { "properties": { "progress_basis": { "const": "user_explicit" } }, "required": ["progress_basis"] },
          "then": { "required": ["evidence_quote"] }
        }
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": ["create", "progress", "status", "update", "schedule", "block", "unblock", "complete", "reopen", "note"]
        },
        "id": { "type": "string", "description": "任务 id（除 create 外必填）" },
        "title": { "type": "string", "description": "create: 任务名称（必填）" },
        "creation_basis": { "type": "string", "enum": ["source_explicit", "user_explicit", "owner_confirmed"], "description": "create 必填：明确安排、用户直接提出或用户确认归属；Agent 推测不得直接创建" },
        "source_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true, "description": "create 必填：支撑新建任务的当前快照 source_id" },
        "description": { "type": "string" },
        "to": { "type": ["integer", "string"], "description": "progress/status/reopen: 目标值（progress 0-100；reopen 0-99；status 仅普通状态）" },
        "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "schedule: 新的预计完成日期" },
        "reason": { "type": "string", "description": "block: 阻塞原因（必填，trim 后非空）" },
        "content": { "type": "string", "description": "note/complete/block 等: 内容说明" },
        "note": { "type": "string" },
        "priority": { "type": "string", "enum": ["urgent", "high", "normal", "low"] },
        "current_status": { "type": "string" },
        "progress_basis": { "type": "string", "enum": ["user_explicit", "milestone_ratio", "agent_estimate"], "description": "progress 必填：百分比的来源口径" },
        "evidence_quote": { "type": "string", "description": "progress_basis=user_explicit 时必填：包含同一百分比数字的用户原话，供预览核对" },
        "notify_mode": { "type": "string", "enum": ["immediate", "merge", "silent"], "description": "除 create 外必填：写入与通知解耦；merge 仅用于 progress" },
        "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "interrupt": { "type": ["boolean", "string"] },
        "at": { "type": "string", "description": "note 回填历史时间，如 2026-08-14T18:00:00" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
