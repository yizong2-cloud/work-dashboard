{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "看板变更建议操作（ops）",
  "description": "一条龙更新流程中 Agent 分析产出的变更建议格式。写入 workflow/ops.json（数组或 { ops: [...] }），由 npm run dashboard:apply 校验并执行。",
  "oneOf": [
    { "type": "array", "items": { "$ref": "#/$defs/op" } },
    {
      "type": "object",
      "required": ["ops"],
      "properties": { "ops": { "type": "array", "items": { "$ref": "#/$defs/op" } } }
    }
  ],
  "$defs": {
    "op": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {
          "type": "string",
          "enum": ["create", "progress", "status", "update", "schedule", "block", "unblock", "complete", "note", "delete"]
        },
        "id": { "type": "string", "description": "任务 id（除 create 外必填）" },
        "title": { "type": "string", "description": "create: 任务名称（必填）" },
        "description": { "type": "string" },
        "to": { "type": ["integer", "string"], "description": "progress/status: 目标值（progress 0-100；status 仅普通状态，blocked/completed 用 block/complete）" },
        "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "schedule: 新的预计完成日期" },
        "reason": { "type": "string", "description": "block: 阻塞原因（必填，trim 后非空）" },
        "content": { "type": "string", "description": "note/complete/block 等: 内容说明" },
        "note": { "type": "string" },
        "priority": { "type": "string", "enum": ["high", "normal", "low"] },
        "current_status": { "type": "string" },
        "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "interrupt": { "type": ["boolean", "string"] },
        "at": { "type": "string", "description": "note 回填历史时间，如 2026-08-14T18:00:00" }
      },
      "additionalProperties": false
    }
  }
}
