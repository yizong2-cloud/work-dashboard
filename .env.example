# ============================================================
# 前端（Vite 构建时读取，必须以 VITE_ 开头；会被打进前端产物，
# 因此这里只放 Supabase 的「公开 anon key」）
# ============================================================

# 数据模式：local = 本地演示数据（无需 Supabase）；supabase = 连接线上库
VITE_DATA_MODE=local

# Supabase 项目地址，例如 https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon（public）key —— 仅此 key 可出现在前端
VITE_SUPABASE_ANON_KEY=

# ============================================================
# Agent / 脚本（本地运行，绝不提交到仓库，绝不进前端）
# 由 scripts/agent.js 读取，用于以「Agent 身份」更新看板数据
# 注意：CLI 与前端共用 VITE_SUPABASE_URL（见 scripts/lib/store.js）
# ============================================================

# Supabase service_role key —— 仅保存在本地 .env，并确保 .env 被 gitignore
SUPABASE_SERVICE_ROLE_KEY=

# 决策答卷的个人机器人（仅 Edge Function Secret；不要放进 VITE_* 或 Git）
FEISHU_PERSONAL_BOT_WEBHOOK_URL=
FEISHU_PERSONAL_BOT_SIGNING_SECRET=
